# Local Docker Compose defaults. Generate secrets with: python3 scripts/init-env.py
APP_ENV=development
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=replace-me
SESSION_SECRET=replace-me
IMPORT_HMAC_SECRET=replace-me
IMPORT_HMAC_SECRETS=
# Relative bind mounts resolve from infra/docker-compose.yml.
DATA_ROOT=./volumes/data
CHATLOG_DB_ROOT=./volumes/chatlog
CHATLOG_CACHE_ROOT=./volumes/sns-cache
CRM_HOST=localhost
CRM_SCHEME=http
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
API_INTERNAL_URL=http://api:8000
