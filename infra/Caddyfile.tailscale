(crm) {
  encode gzip
  handle /api/* {
    reverse_proxy api:8000
  }
  handle /health {
    reverse_proxy api:8000
  }
  handle {
    reverse_proxy web:3000
  }
}

https://{$CRM_TAILSCALE_HOST} {
  tls /certs/nas.crt /certs/nas.key
  import crm
}

https://{$CRM_HOST:NAS} {
  tls internal
  import crm
}
